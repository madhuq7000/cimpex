PORT=3000
MONGO_URI=
JWT_SECRET=

# Frontend origins (comma-separated). Keep both so local + live work.
CLIENT_URL=http://localhost:5173,https://www.amarsavimarsa.com

# Live API origin for Google/Facebook OAuth redirect_uri on the server.
PUBLIC_API_URL=https://www.amarsavimarsa.com

# Optional local API origin (defaults to http://localhost:3000)
LOCAL_PUBLIC_API_URL=http://localhost:3000

# Same Google/Facebook app keys work for local + live.
# Register BOTH redirect URIs in Google/Meta consoles:
#   http://localhost:3000/api/auth/google/callback
#   https://www.amarsavimarsa.com/api/auth/google/callback
#   http://localhost:3000/api/auth/facebook/callback
#   https://www.amarsavimarsa.com/api/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
